# Copy this file to .env (gitignored) and adjust for your machine.
# Consumed by build-firmware.sh.
#
# Ubuntu/WSL prerequisites:
#   sudo apt install build-essential cmake python3-venv \
#     gcc-arm-none-eabi libnewlib-arm-none-eabi libstdc++-arm-none-eabi-newlib
#   git clone --depth 1 --branch 2.1.1 https://github.com/raspberrypi/pico-sdk.git ~/Developer/pico-sdk
#   git -C ~/Developer/pico-sdk submodule update --init --depth 1

# Path to the Raspberry Pi Pico SDK checkout (>= 2.1.1 for v0.7.12).
PICO_SDK_PATH=$HOME/Developer/pico-sdk

# Arm GNU toolchain bin dir. Leave blank to use arm-none-eabi-gcc already on PATH
# (the apt packages above). On macOS, use the official Arm toolchain: the Homebrew
# arm-none-eabi-gcc formula does NOT bundle newlib and will fail to link.
ARM_TOOLCHAIN_BIN=

# Board config folder name under configs/. Required, no default.
GP2040_BOARDCONFIG=DRMFTG24mm

# TRUE reuses the embedded web UI (lib/httpd/fsdata.c) instead of rebuilding it.
# Must be FALSE on the first build to generate fsdata.c.
SKIP_WEBBUILD=FALSE
